# Manter false até OAuth real e fluxos ponta a ponta validados.
REFERRALS_ENABLED=false
DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full
IDENTITY_SECRET=
# OAuth Client ID público, tipo Web, criado no Google Auth Platform. Não é client secret.
GOOGLE_CLIENT_ID=
APP_ORIGIN=https://rfa-fit-loja.vercel.app
# Emails de bootstrap: Gmail ou Google Workspace; privilégio fixado ao sub no primeiro login.
ADMIN_EMAILS=
# Apenas PostgreSQL LOCAL: PGSSL=disable. Produção verifica certificado TLS.
# RESEND_API_KEY e EMAIL_FROM não são usadas nem exigidas.
